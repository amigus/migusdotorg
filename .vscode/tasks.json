{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "pnpm: serve:drafts",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "run",
                "serve:drafts"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
