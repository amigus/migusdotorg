                "reveal": "always",
                "panel": "dedicated",
                "group": "hugo"
            }
        },
        {
            "label": "pnpm: serve",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "run",
                "serve"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "hugo"
            }
        },
        {
            "label": "pnpm: build",
            "type": "shell",
            "command": "pnpm",
            "args": [
                "run",
                "build"
            ],
            "options": {
